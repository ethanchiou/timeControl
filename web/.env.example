# Hosted project: copy SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY from ~/.config/timecontrol/supabase.env
# (or the Supabase dashboard → Project Settings → API). Local Docker stack: `supabase status -o env`.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_KEY=sb_publishable_YOUR_KEY
